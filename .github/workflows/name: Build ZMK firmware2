name: Build ZMK firmware

on:
  workflow_dispatch:
  push:
    paths:
      - 'config/**'
      - '.github/workflows/build.yml'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          submodules: recursive

      # 1. Python環境を設定
      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      # 2. システムに存在するすべてのPython環境へ、west、pyelftools、および今回のエラー原因であるGoogle protobufを強制インストール
      - name: Install West, Elftools, Protobuf & Dependencies
        run: |
          # 1) 指定したPython 3.11環境へのインストール
          python3 -m pip install --upgrade pip
          python3 -m pip install west pyelftools protobuf grpcio-tools
          
          # 2) Linuxのシステム標準Python環境へのインストール（ここを重点補強）
          sudo apt-get update
          sudo apt-get install -y python3-pip python3-setuptools protobuf-compiler
          /usr/bin/python3 -m pip install --break-system-packages west pyelftools protobuf grpcio-tools || true

          echo "$HOME/.local/bin" >> $GITHUB_PATH

      # 3. ZMK/Zephyrに必要なコンパイルツール（Armクロスコンパイラ・Ninja）をインストール
      - name: Install ARM Toolchain
        run: |
          sudo apt-get install -y gcc-arm-none-eabi bsdmainutils ninja-build

      # 4. Zephyrにツールチェーンと使用するPythonを環境変数で強制固定
      - name: Set Toolchain and Python Environment Variables
        run: |
          echo "ZEPHYR_TOOLCHAIN_VARIANT=gnuarmemb" >> $GITHUB_ENV
          echo "GNUARMEMB_TOOLCHAIN_PATH=/usr" >> $GITHUB_ENV
          echo "WEST_PYTHON=/usr/bin/python3" >> $GITHUB_ENV
          echo "PYTHON_EXECUTABLE=/usr/bin/python3" >> $GITHUB_ENV

      # 5. リポジトリ内の設定をもとに環境を初期化
      - name: West Init
        run: |
          west init -l config --mf west-standalone.yml
          west update
          west zephyr-export

      # 6. Zephyrコアのスクリプト要求ファイルをシステムPython側へ一括インストール
      - name: Install Zephyr Additional Python Requirements
        run: |
          if [ -f dependencies/zephyr/scripts/requirements.txt ]; then
            /usr/bin/python3 -m pip install --break-system-packages -r dependencies/zephyr/scripts/requirements.txt || true
          fi

      # 7. 右手専用を指定してコンパイル (環境変数を引き継いで実行)
      - name: Build Right Hand Only (Central)
        run: |
          cd dependencies/zmk/app
          west build -b nice_nano -- -DSHIELD=keyball61_right -DZMK_CONFIG="${{ github.workspace }}/config"

      # 8. 完成した右手単体用の zmk.uf2 を成果物として保存
      - name: Upload Artifacts
        uses: actions/upload-artifact@v4
        with:
          name: keyball61-right-firmware
          path: dependencies/zmk/app/build/zephyr/zmk.uf2
